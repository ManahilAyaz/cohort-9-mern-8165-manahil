# rename this to .env before running the server locally
# never commit the real .env file

PORT=5000
NODE_ENV=development

# mongodb - use a local connection string or one from MongoDB Atlas
MONGO_URI=mongodb://localhost:27017/notes_app

# auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# logging
LOG_LEVEL=info
